{
  "name": "repojudge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "services": "tsx scripts/services.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "fixtures:zip": "tsx scripts/fixtures-zip.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker/index.ts",
    "sandbox:build": "docker compose --profile sandbox build sandbox",
    "sandbox:smoke": "tsx --env-file=.env scripts/sandbox-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1149.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "8.21.3",
    "@vscode/ripgrep": "1.18.0",
    "bullmq": "6.3.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ignore": "7.0.12",
    "ioredis": "6.0.0",
    "lucide-react": "1.54.0",
    "nanoid": "6.0.2",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.8.1",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "dotenv": "18.0.6",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "redis-memory-server": "0.17.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}

STORAGE_DIR=./.data
WORKER_CONCURRENCY=3
MAX_REPO_MB=500
MAX_REPO_FILES=30000
ENABLE_EXECUTION=false
SANDBOX_IMAGE=repojudge-sandbox:latest
APP_URL=http://localhost:3000

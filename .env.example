DATABASE_URL=postgresql://repojudge:repojudge@localhost:5432/repojudge
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
LLM_MODE=live            # live | mock
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
